{
  "name": "@framework/monorepo",
  "private": "true",
  "version": "0.0.0",
  "description": "Zero-dependency modular TypeScript web framework",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.4.2"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --tsconfig tsconfig.test.json --test \"packages/**/*.test.ts\" \"packages/**/*.spec.ts\"",
    "test:watch": "tsx --test --watch 'packages/**/*.test.ts' 'packages/**/*.spec.ts' ",
    "build": "pnpm --recursive run build",
    "clean": "pnpm --recursive clean && rimraf dist"
  },
  "keywords": [
    "typescript",
    "framework",
    "zero-dependency",
    "http",
    "performance"
  ],
  "author": "ESP86",
  "license": "MIT",
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/node": "^22.20.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
