{
  "name": "@framework/monorepo",
  "private": "true",
  "version": "0.0.0",
  "description": "Zero-dependency modular TypeScript web framework",
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "echo 'Framework workspace initialized'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test 'packages/**/*.test.ts' 'packages/**/*.spec.ts'",
    "test:watch": "node --import tsx --test --watch 'packages/**/*.test.ts' 'packages/**/*.spec.ts' ",
    "build": "pnpm --recursive run build",
    "clean": "pnpm --recursive clean && rimraf dist"
  },
  "keywords": [
    "typescript",
    "framework",
    "zero-dependency",
    "http",
    "performance"
  ],
  "author": "ESP86",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0"
  }
}
